CompileFlags:
  CompilationDatabase:
    - "examples/H1OS/build_prod"
    - "examples/H1OS/build_dev"
    - "examples/H1OS/build"
  Add:
    - -Wno-unknown-attributes
    - -Wno-macro-redefined
  Remove:
    - -fno-tree-switch-conversion
    - -f*
    - -m*

Diagnostics:
  UnusedIncludes: Strict
  Suppress:
    - "-Wunused-function"
  ClangTidy:
    Remove:
      - modernize*
      - "*"