{
  "configurations": [
    {
      "name": "ESP32-S3",
      "compilerPath": "${env:USERPROFILE}/.espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/bin/xtensa-esp32s3-elf-gcc.exe",
      "compileCommands": "${workspaceFolder}/examples/H1OS/build_prod/compile_commands.json",
      "cStandard": "gnu17",
      "cppStandard": "gnu++23",
      "intelliSenseMode": "windows-gcc-arm",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/components/h1os/**",
        "${workspaceFolder}/examples/H1OS/main",
        "${workspaceFolder}/examples/H1OS/managed_components/**",
        "C:/esp/v6.1/esp-idf/components/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}",
          "${workspaceFolder}/components/h1os",
          "C:/esp/v6.1/esp-idf/components"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}
