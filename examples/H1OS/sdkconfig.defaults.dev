# Profile: dev (Development, Diagnostics & Debugging)
# -------------------------------------------------------------------------
# Compiler Optimization & Rich Crash Diagnostics
# -------------------------------------------------------------------------
# -Og optimization preserves variables for GDB / OpenOCD debugging
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# Decode panic backtraces into source file names and line numbers over UART
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# -------------------------------------------------------------------------
# System Logging & Color Output
# -------------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

# -------------------------------------------------------------------------
# Heap & Memory Corruption Guardrails
# -------------------------------------------------------------------------
# Poison heap allocations to catch buffer overflows & double-frees immediately
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
CONFIG_HEAP_TRACING_STANDALONE=y

# -------------------------------------------------------------------------
# FreeRTOS Safety, Stack Sentry & Thread Inspection
# -------------------------------------------------------------------------
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Canary pattern detects stack overflows during FreeRTOS context switches
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# -------------------------------------------------------------------------
# LVGL v9 In-Depth Diagnostics & Assertion Guards
# -------------------------------------------------------------------------
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_INFO=y
CONFIG_LV_LOG_PRINTF=y

# Halt immediately on malformed LVGL objects, invalid coordinates, or null pointers
CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_USE_ASSERT_MALLOC=y
CONFIG_LV_USE_ASSERT_STYLE=y
CONFIG_LV_USE_ASSERT_MEM_INTEGRITY=y
CONFIG_LV_USE_ASSERT_OBJ=y

# -------------------------------------------------------------------------
# Watchdog Timers for Task Deadlock Detection
# -------------------------------------------------------------------------
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
