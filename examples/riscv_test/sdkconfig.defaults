# -------------------------------------------------------------------------
# Target Hardware: ESP32-S3-PICO-1-N8R8
# Board: Waveshare ESP32-S3-ePaper-1.54 V2
# Role: Formal ULP-RISC-V Coprocessor Wakeup Validation Test
# -------------------------------------------------------------------------

CONFIG_IDF_TARGET="esp32s3"

# Compiler Optimization & Rich Crash Diagnostics
# -Og optimization preserves variables for GDB / OpenOCD debugging
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTION_LEVEL_DEBUG=y

# Decode panic backtraces into source file names and line numbers over UART
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_USE_EH_FRAME=y

# System Logging & Color Output
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

# CPU Frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=80

# Flash Configuration (8MB QIO 80MHz)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Slow Clock: Strictly Internal 136 kHz RC (No physical 32k crystal on board, GPIO 15/16 multiplexed to I2S)
CONFIG_RTC_CLK_SRC_INT_RC=y

# Power Management & Sleep Power Domains
CONFIG_PM_ENABLE=y
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=y
CONFIG_PM_ESP_SLEEP_POWER_DOWN_CPU=y

# Ultra Low Power (ULP) Coprocessor Configuration
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_RISCV=y
CONFIG_ULP_COPROC_RESERVE_MEM=4096
CONFIG_ULP_RISCV_INTERRUPT_ENABLE=y

# Bootloader Optimizations
CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Enable Output
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y