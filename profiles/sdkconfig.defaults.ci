# Profile: ci (Continuous Integration, Headless Testing & QA)
# =========================================================================
# Compiler Rigor & Warning Enforcement
# =========================================================================
# -Og preserves symbols for automated backtrace line resolution
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTION_LEVEL_DEBUG=y

# Fail the CI build immediately on any compiler warning
CONFIG_COMPILER_WARN_WRITE_STRINGS=y

# =========================================================================
# CI Log Formatting (Plain Text / No Terminal ANSI Escapes)
# =========================================================================
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# CRITICAL FOR CI: Disable color escape codes (\033[0;32m) in log collectors
CONFIG_LOG_COLORS=n
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

# =========================================================================
# Unattended Execution & Headless Crash Handling
# =========================================================================
# Ensure unhandled faults abort and halt immediately rather than rebooting infinitely
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y

# =========================================================================
# LVGL v9 Automated Diagnostic & Integrity Logging
# =========================================================================
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_INFO=y
CONFIG_LV_LOG_PRINTF=y

# Halt immediately on malformed widget allocations or invalid style lookups
CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_USE_ASSERT_MALLOC=y
CONFIG_LV_USE_ASSERT_STYLE=y
CONFIG_LV_USE_ASSERT_MEM_INTEGRITY=y
CONFIG_LV_USE_ASSERT_OBJ=y

# =========================================================================
# FreeRTOS Verification & Static Sentry Checks
# =========================================================================
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Catch task starvation or infinite loops in headless runner harnesses
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10